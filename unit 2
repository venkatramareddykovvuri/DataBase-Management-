-- UNION OPERATION

SELECT player_name FROM Cricket
UNION
SELECT player_name FROM Football;


-- INTERSECTION OPERATION

SELECT player_name
FROM Cricket
WHERE player_name IN
(
    SELECT player_name
    FROM Football
);


-- DIFFERENCE OPERATION

SELECT player_name
FROM Cricket
WHERE player_name NOT IN
(
    SELECT player_name
    FROM Football
);
